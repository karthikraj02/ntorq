# Copy to .env and fill in. Never commit the real .env file.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/ntorq-companion
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ntorq-companion
MONGODB_URI=

# --- JWT ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both must be at least 32 characters and different from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
# Comma-separated list of browser origins allowed to call the API.
# Leave empty to disallow cross-origin browser requests (the mobile app does not need CORS).
CORS_ORIGIN=
# Set to 1 when running behind a single reverse proxy (nginx, Caddy, Cloudflare Tunnel...).
TRUST_PROXY=0

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
